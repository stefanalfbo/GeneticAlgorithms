<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GeneticAlgorithms" Version="$(GeneticAlgorithmsVersion)" />
  </ItemGroup>

  <Target Name="RequireGeneticAlgorithmsVersion" BeforeTargets="Restore;Build">
    <Error
      Condition="'$(GeneticAlgorithmsVersion)' == ''"
      Text="GeneticAlgorithmsVersion must be set, e.g. dotnet run --project tests/GeneticAlgorithms.NuGetSmoke -p:GeneticAlgorithmsVersion=1.0.0" />
  </Target>

</Project>
